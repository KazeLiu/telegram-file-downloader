# Use your secondary account's application credentials.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash

# Filled by the interactive configure command.
TELEGRAM_CHAT=
ALLOWED_EXTENSIONS=.zip,.rar

# Keep empty: on first start, ignore messages older than that start time.
# Later restarts recover new messages received while this watcher was offline.
HISTORY_START_DATE=

# Required for this deployment. Fill the actual SOCKS5 or Mixed port before login.
# Use the LAN address instead if the proxy is not on the Docker Desktop host.
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_HOST=host.docker.internal
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

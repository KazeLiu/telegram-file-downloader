# Use your secondary account's application credentials.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash
TELEGRAM_CHAT=

DOWNLOAD_DIR=C:/TG-Resources
ALLOWED_EXTENSIONS=.zip,.rar,.7z,.tar,.gz,.gzip,.tgz,.bz2,.bzip2,.tbz,.tbz2,.xz,.txz,.zst,.zstd,.tzst,.lzma,.tlz,.z,.taz,.cab,.arj,.lzh,.lha

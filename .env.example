# Create an application at https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash

# The setup command fills this with the selected channel or group ID.
TELEGRAM_CHAT=

# Absolute host paths mounted into the Docker container. Quotes are optional.
# Windows example: C:\Users\YourName\Downloads\Telegram Music
# macOS/Linux example: /Users/your-name/Downloads/Telegram Music
HOST_DOWNLOAD_DIR=
HOST_DATA_DIR=

# Comma-separated extensions. A leading period is optional. This music-focused
# default can be replaced with any extensions, such as .pdf,.jpg,.mp4,.zip.
ALLOWED_EXTENSIONS=.mp3,.flac,.wav,.m4a,.aac,.ogg,.opus,.aiff,.alac

# Optional first catch-up date (UTC), e.g. 2026-09-24 or 2026-09-24T13:15:16Z.
# Only used when this Telegram account/chat has no saved progress yet.
# Leave empty to start tracking when first enabled.
HISTORY_START_DATE=
